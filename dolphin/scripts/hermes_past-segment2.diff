+def plugin_recall_settings(source: Path) -> dict:
+    """The recall the agent's plugin asks past.dev for, read from the plugin itself."""
+    text = (source / PLUGIN / "__init__.py").read_text()
+    value = lambda name: int(re.search(rf"^{name} = ([0-9_]+)", text, re.M).group(1).replace("_", ""))
+    return {"limit": value("RECALL_LIMIT"), "maxTokens": value("RECALL_MAX_TOKENS")}
 
 
